---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import WidgetLayout from "./WidgetLayout.astro";

interface Props { class?: string; style?: string; }
---

<WidgetLayout id="site-announcement" i18nKey={I18nKey.announcement} name={i18n(I18nKey.announcement)} class={Astro.props.class} style={Astro.props.style}>
	<p class="text-75 px-1 py-1 leading-7" data-i18n-key={I18nKey.announcementContent}>{i18n(I18nKey.announcementContent)}</p>
</WidgetLayout>

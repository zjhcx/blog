---
import type { MarkdownHeading } from "astro";
import Announcement from "./Announcement.astro";
import Categories from "./Categories.astro";
import MusicPlayer from "./MusicPlayer.astro";
import Profile from "./Profile.astro";
import SiteStatus from "./SiteStatus.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
}

const className = Astro.props.class;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <MusicPlayer class="onload-animation" style="animation-delay: 125ms"></MusicPlayer>
        <SiteStatus class="onload-animation" style="animation-delay: 150ms"></SiteStatus>
        <Announcement class="onload-animation" style="animation-delay: 175ms"></Announcement>
        <Categories class="onload-animation" style="animation-delay: 200ms"></Categories>
        <Tag class="onload-animation" style="animation-delay: 250ms"></Tag>
    </div>
</div>

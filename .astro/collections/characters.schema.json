{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "novel": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "protagonist",
        "antagonist",
        "supporting",
        "minor",
        "guest"
      ]
    },
    "alias": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "novel"
  ]
}
{
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
				}
			]
		},
		{
			"source": "/rss.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/xml; charset=utf-8"
				}
			]
		},
		{
			"source": "/rss.xsl",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/xsl; charset=utf-8"
				}
			]
		},
		{
			"source": "/:base*/rss.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/xml; charset=utf-8"
				}
			]
		},
		{
			"source": "/:base*/rss.xsl",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/xsl; charset=utf-8"
				}
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/vendor/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/music/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000"
				}
			]
		}
	]
}

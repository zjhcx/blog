{
  "name": "fuwari",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro build && node scripts/optimize-dist.mjs && pagefind --site dist && node scripts/prune-dist.mjs",
    "perf:check": "node perf/bench/check-budget.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "tsc --noEmit --isolatedDeclarations",
    "new-post": "node scripts/new-post.js",
    "timeline:generate": "node scripts/generate-timeline.mjs",
    "timeline:test": "node --test scripts/generate-timeline.test.mjs",
    "summary:generate": "node scripts/generate-ai-summary.mjs",
    "summary:test": "node --test scripts/generate-ai-summary.test.mjs",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@expressive-code/core": "^0.44.3",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.97",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/svelte": "^5.2.4",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "astro-icon": "^1.2.0",
    "github-slugger": "^2.0.0",
    "hastscript": "^9.0.3",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.3",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.6.0",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-expressive-code": "^0.44.3",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^1.0.0",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stylus": "^0.64.0",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "2.6.4",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.2",
    "@waline/client": "^3.16.2",
    "html-minifier-terser": "^7.2.0",
